{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".firebaseignore",
      "**/.*",
      "**/node_modules/**",
      ".git/**",
      "supabase/**",
      "**/*.ps1",
      "**/.env",
      "**/.env.*",
      "**/*.bak*",
      "**/*.bak",
      "**/DEPLOY.md",
      "**/README.md",
      "**/*.md"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=60, must-revalidate"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=60, must-revalidate"
          }
        ]
      },
      {
        "source": "/orders-seed.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|ico|woff|woff2|ttf|eot|css|js|txt|mp4|webm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
